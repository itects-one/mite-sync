### Every endpoint requires HTTP basic authentication.
### Define `auth` in an http-client.env.json next to this file, e.g.:
###   { "dev": { "auth": "bWl0ZS1zeW5jOnlvdXItcGFzc3dvcmQ=" } }
### where the value is base64 of "<user>:<password>" — see HELP.md.

### Classic sync job: copies source → target
POST http://localhost:8080/sync-jobs
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "name": "MonthlySyncJob",
  "from": "01.05.2026",
  "to" : "31.05.2026"
}

### Generate a daily-report proposal (default profile)
POST http://localhost:8080/daily-reports/2026-05-04/preview
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "mainPbiId": 12345,
  "targetHours": 6.25
}

### Generate a daily-report proposal for a specific project profile
POST http://localhost:8080/daily-reports/default/2026-05-04/preview
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "mainPbiId": 12345,
  "targetHours": 6.25
}

### Book the daily-report (entries from preview, edited if needed)
POST http://localhost:8080/daily-reports/2026-05-04/book
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "entries": [
    { "minutes": 15, "note": "#1234 Team Daily" },
    { "minutes": 360, "note": "#12345 Feature XY" }
  ]
}

### Book the daily-report for a specific project profile
POST http://localhost:8080/daily-reports/default/2026-05-04/book
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "entries": [
    { "minutes": 360, "note": "#12345 Feature XY" }
  ]
}

### Preview for a git-activity profile (no mainPbiId needed — tickets come from commit messages)
POST http://localhost:8080/daily-reports/my-project/2026-05-04/preview
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "targetHours": 4.0
}

### Book the git-activity proposal (entries from preview, edited if needed)
POST http://localhost:8080/daily-reports/my-project/2026-05-04/book
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "entries": [
    { "minutes": 90, "note": "#VC-123 Fix the thing" },
    { "minutes": 60, "note": "#VC-124 Other work" }
  ]
}

########################################################################
# Proposal store (review inbox): generate → review/edit → confirm
# Proposals are persisted (H2 file db); generation reuses the preview
# pipeline, confirmation reuses the book pipeline.
########################################################################

### Generate (or regenerate) the DRAFT proposal for a project profile + date
POST http://localhost:8080/proposals/default/2026-05-04
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "mainPbiId": 12345,
  "targetHours": 6.25
}

### List all proposals (inbox, newest first)
GET http://localhost:8080/proposals
Authorization: Basic {{auth}}

### Get a single proposal by id
GET http://localhost:8080/proposals/1
Authorization: Basic {{auth}}

### Edit the entries of a DRAFT proposal (before confirming)
# "source" is derived server-side and ignored here: an entry that comes back unchanged keeps the
# provenance it was generated with, everything changed or added is returned as "manual".
PUT http://localhost:8080/proposals/1/entries
Authorization: Basic {{auth}}
Content-Type: application/json

{
  "entries": [
    { "minutes": 15,  "note": "#1234 Team Daily" },
    { "minutes": 360, "note": "#12345 Feature XY" }
  ]
}

### Confirm a DRAFT proposal — books its entries into Mite
POST http://localhost:8080/proposals/1/confirm
Authorization: Basic {{auth}}

### Delete a proposal
DELETE http://localhost:8080/proposals/1
Authorization: Basic {{auth}}
